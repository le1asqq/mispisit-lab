<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — SmartQueue</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            background: #eef2f7;
            color: #2c3e50;
            min-height: 100vh;
        }
        header {
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: white;
            padding: 30px 40px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
            text-align: center;
        }
        header .brand {
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }
        header .subtitle {
            font-size: 16px;
            font-weight: 400;
            color: #c9d8f0;
            margin-bottom: 22px;
            letter-spacing: 0.5px;
        }
        nav a {
            color: #eaf2ff;
            margin: 0 6px;
            text-decoration: none;
            padding: 10px 24px;
            border-radius: 6px;
            transition: background 0.2s, transform 0.1s;
            display: inline-block;
            font-size: 17px;
        }
        nav a:hover {
            background: rgba(255,255,255,0.18);
            transform: translateY(-1px);
        }
        main {
            padding: 40px;
            max-width: 900px;
            margin: 30px auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            min-height: 400px;
        }
        h2 { color: #1e3c72; margin-top: 0; font-weight: 600; }
        h3 { color: #2a5298; font-weight: 600; }
        p { line-height: 1.6; }

        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 20px;
            border-radius: 8px;
            overflow: hidden;
        }
        th, td {
            padding: 14px;
            text-align: left;
            border-bottom: 1px solid #eef2f7;
        }
        th {
            background: #f4f7fb;
            font-weight: 600;
            color: #555;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        tr:hover { background: #f9fbfd; }

        .btn {
            display: inline-block;
            padding: 12px 26px;
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 15px;
            font-weight: 500;
            transition: all 0.2s;
            box-shadow: 0 2px 6px rgba(52,152,219,0.3);
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(52,152,219,0.4);
        }
        .btn-green {
            background: linear-gradient(135deg, #27ae60, #1e8449);
            box-shadow: 0 2px 6px rgba(39,174,96,0.3);
        }
        .btn-green:hover {
            box-shadow: 0 6px 14px rgba(39,174,96,0.4);
        }
        .btn-gray {
            background: linear-gradient(135deg, #7f8c8d, #5d6d7e);
            box-shadow: 0 2px 6px rgba(127,140,141,0.3);
        }

        .card {
            background: #f9fbfd;
            border-left: 4px solid #3498db;
            padding: 22px;
            border-radius: 8px;
            margin: 20px 0;
        }
        .card-success {
            border-left-color: #27ae60;
            background: #f0faf4;
        }

        .error {
            background: #fdecea;
            border-left: 4px solid #e74c3c;
            padding: 25px;
            border-radius: 8px;
            color: #8b1e12;
        }
        .error h2 {
            color: #c0392b;
            margin-top: 0;
        }
        .error p { color: #8b1e12; }
        .error b { color: #c0392b; }

        input, select {
            padding: 12px;
            margin: 8px 0;
            width: 100%;
            max-width: 350px;
            border: 1px solid #d5dbe2;
            border-radius: 6px;
            font-size: 15px;
            background: white;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52,152,219,0.15);
        }

        label { font-size: 15px; color: #555; }
    </style>
</head>
<body>
    <header>
        <div class="brand">SmartQueue</div>
        <div class="subtitle">Система электронной очереди</div>
        <nav>
            <a href="/">Главная</a>
            <a href="/queue">Очередь</a>
            <a href="/tickets/new">Получить талон</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>