@page "/access-denied"
@model AccessDeniedModel
@{
    ViewData["Title"] = "Отказ";
}

<div class="sq-panel">
    <div class="sq-error mb-4">
        <h2>Доступ запрещён</h2>
        <p class="mb-2">Вы попытались выполнить действие, на которое у вас нет прав.</p>
        <p class="mb-0"><strong>Причина:</strong> роль «Клиент» не может управлять очередью. Вызов клиентов доступен только оператору.</p>
    </div>
    <a href="/" class="sq-btn sq-btn-gray">Вернуться на главную</a>
</div>