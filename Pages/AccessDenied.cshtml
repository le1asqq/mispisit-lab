@page "/access-denied"
@model AccessDeniedModel
@{
    ViewData["Title"] = "Отказ";
}

<div class="error">
    <h2>Доступ запрещён</h2>
    <p>Вы попытались выполнить действие, на которое у вас нет прав.</p>
    <p><b>Причина:</b> роль «Клиент» не может управлять очередью. Только оператор может вызывать клиентов.</p>
</div>
<p style="margin-top: 25px;">
    <a href="/" class="btn btn-gray">Вернуться на главную</a>
</p>